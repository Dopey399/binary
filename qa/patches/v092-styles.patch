--- a/android-build/app/src/main/assets/styles.css
+++ b/android-build/app/src/main/assets/styles.css
@@ -1194,0 +1195,24 @@
+
+
+/* v0.9.2 crop-first direct-touch editing */
+.preview-transform-box.crop-mode {
+  border-color: rgba(85,255,154,.98);
+  box-shadow: 0 0 0 1px rgba(49,215,255,.42), 0 0 14px rgba(85,255,154,.28);
+  background: rgba(85,255,154,.018);
+}
+.preview-transform-box.layer-mode {
+  border-style: dashed;
+  border-color: rgba(255,255,255,.92);
+  box-shadow: 0 0 0 1px rgba(49,215,255,.65), 0 0 14px rgba(49,215,255,.32);
+}
+.preview-mode-handle {
+  position:absolute; left:50%; top:-39px; transform:translateX(-50%); min-width:58px; height:28px; padding:0 8px;
+  display:grid; place-items:center; border:1px solid rgba(255,255,255,.82); border-radius:14px;
+  background:rgba(6,13,22,.92); color:#f8fafc; font-size:10px; font-weight:900; letter-spacing:.03em;
+  touch-action:manipulation; box-shadow:0 0 10px rgba(0,0,0,.6); cursor:pointer;
+}
+.preview-transform-box.crop-mode .preview-transform-handle { background:#35e58a; box-shadow:0 0 10px rgba(53,229,138,.62); }
+.preview-transform-box.crop-mode .preview-move-handle { border-color:rgba(85,255,154,.9); box-shadow:0 0 0 1px rgba(85,255,154,.32),0 0 14px rgba(85,255,154,.22); }
+@media (orientation:portrait) and (max-width:680px) {
+  .preview-mode-handle { top:-35px; min-width:54px; height:26px; font-size:9px; }
+}
